# Kopirati u .env i popuniti stvarnim vrednostima. .env se ne commit-uje (u .gitignore).

# Opcija A - direktan TypeSafe AI nalog:
TYPESAFE_API_KEY=your-typesafe-api-key-here

# Opcija B - pristup preko Vercel AI Gateway-a (ako se Jev koristi "preko Vercela"):
# TYPESAFE_API_KEY=your-vercel-ai-gateway-api-key-here
# TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/v1
# JEV_MODEL=typesafe-ai/jev

# Naziv modela koji se prosledjuje TypeSafeClient-u (podrazumevano "jev-latest" za direktan pristup)
JEV_MODEL=jev-latest
