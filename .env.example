# Kopirati u .env i popuniti stvarnim vrednostima. .env se ne commit-uje (u .gitignore).

# Direktan TypeSafe AI nalog (Vercel AI Gateway ne izlaze evaluate/Jev
# funkcionalnost za Python, samo za JS "ai" SDK - videti PLAN.md).
TYPESAFE_API_KEY=your-typesafe-api-key-here

# Naziv modela koji se prosledjuje TypeSafeClient-u
JEV_MODEL=jev-latest
